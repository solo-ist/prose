# Prose Gateway — Phase 0 (#765). Copy to `.env` and fill in. NEVER commit `.env`.

GATEWAY_PORT=4000
NODE_ENV=development

# --- LLM proxy ---
# The OPERATOR's Anthropic key (gateway-side; never the client's). Required in prod.
ANTHROPIC_API_KEY=
# For local testing WITHOUT a real key, point at the mock upstream instead:
# UPSTREAM_URL=http://localhost:4001

# --- Auth + DB ---
# Render Postgres requires SSL: append ?sslmode=require on Render.
DATABASE_URL=postgresql://prose:prose@localhost:5433/prose_gateway?schema=public
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:4000

# --- Email delivery (#813) ---
# Resend API key; when unset (dev default) the link is logged to stdout instead.
RESEND_API_KEY=
# Sender address. Example: "Prose <signin@prose.solo.ist>". The domain must have
# SPF + DKIM verified in the Resend dashboard before production use.
MAIL_FROM=Prose <signin@prose.solo.ist>
# RESEND_API_URL is for the test suite only (points at a local mock server).
# Never set this in production.
# RESEND_API_URL=

# --- CORS allowlist (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://prose.solo.ist

# --- Origin isolation (#902) ---
# The share-host origin (a separate domain/subdomain from BETTER_AUTH_URL).
# Required in production; unset in development (single-origin, accepted debt).
# SHARE_BASE_URL=https://share.prose.solo.ist

# --- Cloudflare R2 (BLOBS ONLY; stubbed in Phase 0 — unused until Phase 2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
