# Prose Gateway — Phase 0 (#765). Copy to `.env` and fill in. NEVER commit `.env`.

GATEWAY_PORT=4000
NODE_ENV=development

# --- LLM proxy ---
# The OPERATOR's Anthropic key (gateway-side; never the client's). Required in prod.
ANTHROPIC_API_KEY=
# For local testing WITHOUT a real key, point at the mock upstream instead:
# UPSTREAM_URL=http://localhost:4001

# --- Auth + DB ---
# Render Postgres requires SSL: append ?sslmode=require on Render.
DATABASE_URL=postgresql://prose:prose@localhost:5433/prose_gateway?schema=public
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:4000

# --- CORS allowlist (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://prose.solo.ist

# --- Share origin isolation (#902) ---
# When set, /s/* is served from this separate host. Required in prod (boot fails without it).
# SHARE_BASE_URL=https://share.prose.solo.ist

# --- Per-publication subdomain isolation (#917) ---
# When "1", each publication is served at <label>.<share host>. Requires SHARE_BASE_URL
# and a wildcard DNS+TLS config (*.share.prose.solo.ist on Render + Hover DNS).
# MUST be enabled only AFTER the wildcard domain is live — or TLS errors on first GET.
# SHARE_SUBDOMAINS=1

# --- Cloudflare R2 (BLOBS ONLY; stubbed in Phase 0 — unused until Phase 2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
