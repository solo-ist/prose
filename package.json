{
  "name": "prose",
  "version": "1.7.1",
  "description": "A minimal markdown editor with AI chat",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:env && npm run build:buildinfo && npm run build:skill && npm run build:mcp-stdio && npm run build:preload && electron-vite dev",
    "dev:kill": "kill $(cat .dev.pid 2>/dev/null) 2>/dev/null || true; lsof -ti:9222 | xargs kill -9 2>/dev/null || true; lsof -ti:5173 | xargs kill -9 2>/dev/null || true",
    "dev:restart": "npm run dev:kill && sleep 2 && npm run dev",
    "build:env": "node -e \"require('fs').writeFileSync('src/main/env.ts', '// Auto-generated — do not edit\\nexport const IS_MAS_BUILD = ' + (process.env.MAS_BUILD === '1') + '\\n')\"",
    "build:buildinfo": "node -e \"const h=(()=>{try{return require('child_process').execSync('git rev-parse --short HEAD').toString().trim()}catch{return 'unknown'}})(); const v=require('./package.json').version; require('fs').writeFileSync('src/renderer/buildInfo.generated.ts', '// Auto-generated — do not edit\\nexport const GIT_HASH = ' + JSON.stringify(h) + '\\nexport const APP_VERSION = ' + JSON.stringify(v) + '\\n')\"",
    "build:skill": "node scripts/build-skill.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build": "npm run build:env && npm run build:buildinfo && npm run build:skill && npm run build:mcp-stdio && electron-vite build && npm run build:preload",
    "build:preload": "npx esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=out/preload-cjs/index.cjs --external:electron --define:process.env.MAS_BUILD=\\\"${MAS_BUILD:-}\\\"",
    "build:mcp-stdio": "npx esbuild src/mcp-stdio/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=out/mcp-stdio.cjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mas": "MAS_BUILD=1 npm run build && electron-builder --mac mas",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "dev:web": "npm run build:buildinfo && vite --config vite.web.config.ts",
    "build:web": "npm run build:buildinfo && vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts --open",
    "test:e2e": "npm run build && npx playwright test",
    "test:e2e:dev": "npx playwright test",
    "test:web": "npm run build:web && npx playwright test --config playwright.web.config.ts",
    "test:web:dev": "npx playwright test --config playwright.web.config.ts",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json --noEmit",
    "clean": "rm -rf out dist node_modules/.vite .dev.pid",
    "clean:hard": "npm run clean && rm -rf node_modules && rm -rf \"$HOME/Library/Application Support/prose\" \"$HOME/.prose\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.1",
    "@anthropic-ai/sdk": "^0.39.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@sentry/electron": "^7.10.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^2.11.2",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/js-yaml": "^4.0.9",
    "ai": "^6.0.3",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.25.0",
    "googleapis": "^171.4.0",
    "js-yaml": "^4.3.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "markdown-it-footnote": "^3.0.3",
    "marked": "^17.0.1",
    "react-resizable-panels": "^2.1.7",
    "rmapi-js": "^10.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tiptap-footnotes": "^3.0.1",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.2",
    "zod-to-json-schema": "^3.25.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^41.10.3",
    "electron-builder": "^26.15.3",
    "electron-playwright-helpers": "^2.1.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "overrides": {
    "minimatch": ">=10.2.3",
    "hono": ">=4.12.25",
    "@hono/node-server": ">=2.1.1",
    "fast-uri": ">=4.1.4",
    "tmp": ">=0.2.6",
    "esbuild": ">=0.28.1",
    "linkify-it": ">=6.1.0",
    "form-data": ">=4.0.6",
    "@babel/core": ">=7.29.6 <8",
    "tar": ">=7.5.16",
    "markdown-it": ">=14.2.0",
    "@opentelemetry/core": ">=2.8.0"
  }
}
