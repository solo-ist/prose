        "type": "string",
      },
    },
    "required": [
      "id",
      "content",
    ],
    "type": "object",
  },
  "select_tab": {
    "additionalProperties": false,
    "properties": {
      "match": {
        "description": "Case-insensitive substring to match against tab title and path basename. Use when you only have a partial name. If multiple tabs match, returns an error with candidates. If none match, returns "tab not found".",
        "type": "string",
      },
      "tabId": {
        "description": "The exact tab ID from list_tabs. Preferred over match — use this when you have the ID.",
        "type": "string",
      },
    },
    "type": "object",
  },
  "suggest_delete": {
    "additionalProperties": false,
    "properties": {
      "document": {
        "description": "Optional. The document to act on: its documentId or path, as list_tabs reports them. It must be open in Prose (open_file opens it). Omit it to act on the active tab. Targeting a document never switches the tab the writer sees.",
        "maxLength": 4096,
        "type": "string",
      },
      "nodeId": {
        "description": "The paragraph or heading that holds the text, from read_document.",
        "type": "string",
      },
      "search": {
        "description": "The exact phrase to propose for deletion, as it appears once in the node’s current text.",
        "maxLength": 5000,
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "nodeId",
      "search",
    ],
    "type": "object",
  },
  "suggest_edit": {
    "additionalProperties": false,
    "properties": {
      "comment": {
        "description": "Brief rationale for the change, shown in the diff UI. Keep under 20 words.",
        "type": "string",
      },
      "content": {
        "description": "The suggested new content for the node",
        "type": "string",
      },
      "document": {
        "description": "Optional. The document to act on: its documentId or path, as list_tabs reports them. It must be open in Prose (open_file opens it). Omit it to act on the active tab. Targeting a document never switches the tab the writer sees.",
        "maxLength": 4096,
        "type": "string",
      },
      "nodeId": {
        "description": "The ID of the node to suggest changes for. Get node IDs from read_document.",
        "type": "string",
      },
      "search": {
        "description": "Original text content of the node (from read_document). Used as fallback to locate the node if nodeId is stale.",
        "type": "string",
      },
    },
    "required": [
      "nodeId",
      "content",
    ],
    "type": "object",
  },
  "suggest_insert": {
    "additionalProperties": false,
    "properties": {
      "document": {
        "description": "Optional. The document to act on: its documentId or path, as list_tabs reports them. It must be open in Prose (open_file opens it). Omit it to act on the active tab. Targeting a document never switches the tab the writer sees.",
        "maxLength": 4096,
        "type": "string",
      },
      "nodeId": {
        "description": "The paragraph or heading to insert into, from read_document. Give nodeId, search, or both.",
        "type": "string",
      },
      "position": {
        "description": "Where: before or after the search phrase (default after), or at the start or end of the node (default end when there is no search).",
        "enum": [
          "before",
          "after",
          "start",
          "end",
        ],
        "type": "string",
      },
      "search": {
        "description": "A phrase of the node’s current text to insert next to (with position before or after). Without nodeId, the one paragraph that contains it.",
        "type": "string",
      },
      "text": {
        "description": "The text to insert: plain text within the paragraph, no line breaks.",
        "maxLength": 5000,
        "minLength": 1,
        "type": "string",
      },
    },
    "required": [
      "text",
    ],
    "type": "object",
  },
}
`;
